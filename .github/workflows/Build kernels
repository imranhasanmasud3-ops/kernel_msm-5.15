name: Build kernels

on:
  workflow_dispatch:
    inputs:
      kernelSource:
        description: 'Kernel source URL'
        required: true
        default: 'https://github.com/topnotchfreaks/kernel_msm-5.15'
      kernelBranch:
        description: 'Kernel branch'
        required: true
        default: 'chickernel'
      kernelDevice:
        description: 'Device name for defconfig'
        required: true
        default: 'tapas'
      localVersion:
        description: 'Custom version suffix'
        required: false
        default: ''
      buildKSU:
        description: 'Include KernelSU variant'
        required: true
        default: 'true'
      LTOOptimizations:
        description: 'LTO mode (thin/full/none)'
        required: true
        default: 'thin'
      optimizationLevel:
        description: 'Optimization level (O2/O3)'
        required: true
        default: 'O2'
      buildToolchains:
        description: 'Build toolchains (custom-tools/gcc)'
        required: true
        default: 'custom-tools'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up environment
        run: |
          echo "kernelDir=kernel" >> $GITHUB_ENV
          echo "kernelName=kernel_msm-5.15" >> $GITHUB_ENV
          echo "DEFCONFIG_NAME=${{ github.event.inputs.kernelDevice }}_defconfig" >> $GITHUB_ENV
          echo "KERNEL_VERSION=5.15" >> $GITHUB_ENV
          echo "ZIP_NAME=AnyKernel3-${{ github.event.inputs.kernelDevice }}-$(date +%Y%m%d).zip" >> $GITHUB_ENV

      - name: Clone kernel source
        run: |
          git clone --depth=1 -b ${{ github.event.inputs.kernelBranch }} ${{ github.event.inputs.kernelSource }} ${{ env.kernelDir }}/${{ env.kernelName }}

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential libncurses-dev bison flex libssl-dev libelf-dev bc zip wget git

      - name: Add NetHunter Wi-Fi Drivers
        working-directory: ./${{ env.kernelDir }}/${{ env.kernelName }}
        run: |
          git clone --depth=1 https://github.com/aircrack-ng/rtl8812au.git drivers/net/wireless/realtek/rtl8812au || true
          git clone --depth=1 https://github.com/aircrack-ng/rtl8814au.git drivers/net/wireless/realtek/rtl8814au || true
          git clone --depth=1 https://github.com/aircrack-ng/rtl8821au.git drivers/net/wireless/realtek/rtl8821au || true

          CONFIG_FILE="arch/arm64/configs/${{ env.DEFCONFIG_NAME }}"

          echo "CONFIG_RT2800USB=m" >> "$CONFIG_FILE"
          echo "CONFIG_RT2800USB_RT53XX=y" >> "$CONFIG_FILE"
          echo "CONFIG_RT2800USB_RT33XX=y" >> "$CONFIG_FILE"
          echo "CONFIG_RT2800USB_RT35XX=y" >> "$CONFIG_FILE"
          echo "CONFIG_MT7601U=m" >> "$CONFIG_FILE"
          echo "CONFIG_MT76x0U=m" >> "$CONFIG_FILE"
          echo "CONFIG_MT76x2U=m" >> "$CONFIG_FILE"
          echo "CONFIG_ATH9K_HTC=m" >> "$CONFIG_FILE"
          echo "CONFIG_RTL8812AU=m" >> "$CONFIG_FILE"
          echo "CONFIG_RTL8814AU=m" >> "$CONFIG_FILE"
          echo "CONFIG_RTL8821AU=m" >> "$CONFIG_FILE"
          echo "CONFIG_CFG80211=m" >> "$CONFIG_FILE"
          echo "CONFIG_MAC80211=m" >> "$CONFIG_FILE"
          echo "CONFIG_MAC80211_MESH=y" >> "$CONFIG_FILE"
          echo "CONFIG_WIRELESS_EXT=y" >> "$CONFIG_FILE"
          echo "CONFIG_WEXT_CORE=y" >> "$CONFIG_FILE"
          echo "CONFIG_WEXT_PROC=y" >> "$CONFIG_FILE"
          echo "CONFIG_WEXT_SPY=y" >> "$CONFIG_FILE"
          echo "CONFIG_MAC80211_DEBUGFS=y" >> "$CONFIG_FILE"

          mkdir -p firmware
          wget -q https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain/rt2870.bin -O firmware/rt2870.bin || true
          wget -q https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain/htc_9271.fw -O firmware/htc_9271.fw || true

      - name: Setup Clang
        run: |
          git clone --depth=1 https://github.com/kdrag0n/proton-clang.git proton-clang || true
          echo "$PWD/proton-clang/bin" >> $GITHUB_PATH

      - name: Configure kernel
        working-directory: ./${{ env.kernelDir }}/${{ env.kernelName }}
        run: |
          CONFIG_FILE="arch/arm64/configs/${{ env.DEFCONFIG_NAME }}"
          sed -i '/CONFIG_LTO_CLANG_FULL/d' "$CONFIG_FILE"
          if [ "${{ github.event.inputs.localVersion }}" ]; then
            echo "CONFIG_LOCALVERSION=\"${{ github.event.inputs.localVersion }}\"" >> "$CONFIG_FILE"
          fi
          if [ "${{ github.event.inputs.LTOOptimizations }}" = "thin" ]; then
            echo "CONFIG_LTO_CLANG=y" >> "$CONFIG_FILE"
            echo "CONFIG_LTO_CLANG_THIN=y" >> "$CONFIG_FILE"
            echo "CONFIG_THINLTO=y" >> "$CONFIG_FILE"
          else
            echo "CONFIG_LTO_CLANG=y" >> "$CONFIG_FILE"
            echo "CONFIG_LTO_CLANG_FULL=y" >> "$CONFIG_FILE"
          fi
          echo "CONFIG_KALLSYMS=y" >> "$CONFIG_FILE"
          echo "CONFIG_TMPFS_XATTR=y" >> "$CONFIG_FILE"
          echo "CONFIG_TMPFS_POSIX_ACL=y" >> "$CONFIG_FILE"
          echo "CONFIG_OVERLAY_FS=y" >> "$CONFIG_FILE"

      - name: Build Kernel
        working-directory: ./${{ env.kernelDir }}/${{ env.kernelName }}
        run: |
          export PATH="$PWD/proton-clang/bin:$PATH"
          export CLANG_TRIPLE="aarch64-linux-gnu-"
          export CC=clang
          export AR=llvm-ar
          export AS=llvm-as
          export NM=llvm-nm
          export OBJCOPY=llvm-objcopy
          export OBJDUMP=llvm-objdump
          export STRIP=llvm-strip
          make O=out ARCH=arm64 ${{ env.DEFCONFIG_NAME }} LLVM=1
          make -j$(nproc --all) O=out ARCH=arm64 LLVM=1

      - name: Create AnyKernel3 ZIP
        run: |
          git clone --depth=1 https://github.com/osm0sis/AnyKernel3.git AnyKernel3 || true
          cp ./${{ env.kernelDir }}/${{ env.kernelName }}/out/arch/arm64/boot/Image.gz-dtb AnyKernel3/ 2>/dev/null || \
          cp ./${{ env.kernelDir }}/${{ env.kernelName }}/out/arch/arm64/boot/Image.gz AnyKernel3/ 2>/dev/null || \
          cp ./${{ env.kernelDir }}/${{ env.kernelName }}/out/arch/arm64/boot/Image AnyKernel3/ 2>/dev/null || true
          cd AnyKernel3
          zip -r ../${{ env.ZIP_NAME }} .

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.ZIP_NAME }}
          path: ${{ env.ZIP_NAME }}
          retention-days: 7
